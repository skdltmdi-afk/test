# ── 필수 ──────────────────────────────────────────────
# 팀 공용 비밀번호. 운영(production)에서는 비어 있으면 모든 요청을 거부합니다.
APP_PASSWORD=change-me

# OpenAI API 키 (음성 변환 + 회의록 생성 모두에 사용)
OPENAI_API_KEY=

# ── 선택 ──────────────────────────────────────────────
# 음성 변환 모델. 기본 gpt-4o-transcribe.
# gpt-transcribe 로 바꿀 수 있으나, 이 경우 languages[] / keywords[] 형식으로 보냅니다(공식 문서에서 형식 미확인).
# OPENAI_STT_MODEL=gpt-4o-transcribe

# 회의록 생성 모델. 기본 gpt-6.1-sol. 품질 우선이면 gpt-6-astra, 비용 우선이면 gpt-6-luna.
# OPENAI_MINUTES_MODEL=gpt-6.1-sol

# 분당 요청 상한(IP 기준). 기본: 일반 요청 12, 음성 조각 요청 60.
# RATE_LIMIT_PER_MINUTE=12
# RATE_LIMIT_TRANSCRIBE_PER_MINUTE=60
